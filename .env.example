# ==============================================================================
# DATABASE CONFIGURATION (Supabase PostgreSQL)
# ==============================================================================
# Connection-pooled database URL (port 6543, pgbouncer=true&connection_limit=3) for serverless queries
# Example format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=3
DATABASE_URL=""

# Direct database connection URL (port 5432) for migrations and schema push
DIRECT_URL=""

# ==============================================================================
# SUPABASE CLIENT CONFIGURATION
# ==============================================================================
# Supabase project URL (public)
NEXT_PUBLIC_SUPABASE_URL=""

# Supabase public anonymous API key (public)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Supabase database administrative password (keep secret)

# ==============================================================================
# ADMIN AUTHENTICATION & SECURITY
# ==============================================================================
# Port for local admin gateway (legacy/local development)

# Host binding for admin gateway (e.g. 127.0.0.1)

# Master admin email address for dashboard login
ADMIN_EMAIL=""

# Master admin password (plain text or bcrypt hash depending on setup)
ADMIN_PASSWORD=""

# Master 2FA / Security Key for second-factor admin authentication
ADMIN_SECURITY_KEY=""

# Cryptographic secret for signing Admin JWT tokens
ADMIN_JWT_SECRET=""

# Secret key for NextAuth sessions
NEXTAUTH_SECRET=""

# ==============================================================================
# APPLICATION & DEPLOYMENT URL
# ==============================================================================
# Public storefront URL (e.g., https://yourstore.netlify.app or http://localhost:3000)
NEXT_PUBLIC_APP_URL=""

# ==============================================================================
# ORDERS & NOTIFICATIONS
# ==============================================================================
# Path to local CSV file storing orders (legacy backup)

# Recipient WhatsApp phone number with country code (e.g., +216xxxxxxxx) for COD alerts
ADMIN_WHATSAPP_PHONE=""

# CallMeBot Free API key for WhatsApp alerts (optional)
CALLMEBOT_API_KEY=""
